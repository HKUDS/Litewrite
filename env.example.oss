# Litewrite OSS environment template
#
# This OSS build does NOT send emails and does not require any SMTP config.
# Copy to `.env` and fill the secrets you need.
#
#   cp env.example.oss .env
#

# ------------------------------------------------------------------------------
# NextAuth
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=dev-secret-change-me

# Optional (useful in production / when behind a proxy)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Internal service auth (Next.js <-> ai-server / ws-server)
# ------------------------------------------------------------------------------
INTERNAL_API_SECRET=dev-internal-secret

# ------------------------------------------------------------------------------
# WebSocket (client connection URL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# ------------------------------------------------------------------------------
# AI providers
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY is required if you want AI features enabled.
OPENROUTER_API_KEY=
# Optional: multiple keys for rotation
OPENROUTER_API_KEYS=
OPENROUTER_KEY_STRATEGY=round_robin

# Embeddings (required by Deep Research if enabled)
EMBEDDING_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=

# Optional: web search provider used by Deep Research
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# nanobot (Feishu bot integration)
# ------------------------------------------------------------------------------
# Set FEISHU_ENABLED=true and fill in the Feishu app credentials to enable.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Your Litewrite user UUID (from the database) for project ownership mapping
NANOBOT_DEFAULT_LITEWRITE_USER_ID=

# ------------------------------------------------------------------------------
# Optional: Redis
# ------------------------------------------------------------------------------
# Enables collab persistence + rate limiting where applicable.
# - If you run via docker compose, use the internal service name:
#   REDIS_URL=redis://redis:6379
# - If you run services directly on your host machine:
#   REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Storage (S3/MinIO)
# ------------------------------------------------------------------------------
# When running via `docker compose`, MinIO values are usually provided by compose.
# These are mainly for non-Docker / external deployments.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=litewrite
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
