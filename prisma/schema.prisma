// Prisma Schema for Litewrite
// 使用 SQLite 作为数据库

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js 需要的模型
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  // Token type: password_reset
  type       String   @default("password_reset")

  @@unique([identifier, token])
  @@index([type])
}

// 用户模型
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String? // 邮箱密码注册用户的哈希密码
  image         String?
  status        String    @default("active") // "active" | "disabled"

  // 关联
  accounts          Account[]
  sessions          Session[]
  projects          Project[]             @relation("ProjectOwner")
  collaborations    ProjectCollaborator[]
  tags              Tag[]
  chatMessages      ChatMessage[]
  settings          UserSettings?
  projectVersions   ProjectVersion[] // 用户创建的版本
  templates         Template[] // 用户上传的模板
  templateFavorites TemplateFavorite[] // 收藏的模板

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 项目模型
model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  mainFile    String  @default("main.tex")

  // 项目编译器（项目级配置，优先于用户设置；为空时由服务端 fallback）
  // "pdflatex" | "xelatex" | "lualatex" | "latex"
  compiler String?

  // 所有者
  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // 可见性: private(仅所有者), shared(链接分享), public(公开)
  visibility String @default("private")

  // 分享链接 token（唯一）
  shareToken String? @unique

  // 项目状态: active(正常), archived(归档), trashed(回收站)
  status    String    @default("active")
  trashedAt DateTime?

  // 协作者
  collaborators ProjectCollaborator[]

  // 标签
  tags ProjectTag[]

  // 聊天消息
  chatMessages ChatMessage[]

  // 版本历史
  versions ProjectVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 项目协作者
model ProjectCollaborator {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 角色: editor(可编辑), viewer(只读)
  role String @default("editor")

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// 标签模型
model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#6B7280")

  // 所有者
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 关联的项目
  projects ProjectTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// 项目标签关联
model ProjectTag {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, tagId])
}

// 聊天消息
model ChatMessage {
  id      String @id @default(cuid())
  content String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// 用户设置
model UserSettings {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 编辑器设置
  autoComplete      Boolean @default(true)
  autoCloseBrackets Boolean @default(true)
  codeCheck         Boolean @default(false)
  keybindings       String  @default("none") // "none" | "vim" | "emacs"
  spellcheck        Boolean @default(false)
  spellcheckLang    String  @default("en")

  // 编译器设置
  compiler String @default("pdflatex") // "pdflatex" | "xelatex" | "lualatex" | "latex"

  // 版本历史设置
  autoSaveVersion Boolean @default(true) // 编译成功后自动保存版本

  // PDF 查看器设置
  pdfViewer String @default("litewrite") // "browser" | "litewrite"

  // 外观设置
  theme    String @default("system") // "light" | "dark" | "system"
  fontSize Int    @default(14)

  updatedAt DateTime @updatedAt
}

// ============================================
// Merkle Tree 版本控制系统
// ============================================

// 内容寻址 Blob（文件内容）
// 存储在 S3: blobs/{hash前2位}/{hash}
model Blob {
  hash      String   @id // SHA-256 哈希（64字符）
  size      Int // 文件大小 (bytes)
  mimeType  String? // MIME 类型
  refCount  Int      @default(1) // 引用计数（用于垃圾回收）
  createdAt DateTime @default(now())

  @@index([refCount])
}

// 目录树结构
// Tree 的哈希是其所有条目排序后的哈希
model Tree {
  hash      String      @id // 目录内容的 SHA-256 哈希
  entries   TreeEntry[] // 子条目
  createdAt DateTime    @default(now())
}

// 目录条目（Tree 的子项）
model TreeEntry {
  id String @id @default(cuid())

  treeHash String // 所属 Tree
  tree     Tree   @relation(fields: [treeHash], references: [hash], onDelete: Cascade)

  name       String // 文件/目录名
  type       String // "blob" | "tree"
  targetHash String // 指向 Blob 或 Tree 的哈希
  mode       Int    @default(644) // 文件权限模式

  @@unique([treeHash, name])
  @@index([targetHash])
}

// 项目版本（类似 Git Commit）
// 使用 Merkle Tree 结构实现内容寻址和去重
model ProjectVersion {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String // 版本名称，如 "v1.0" 或 "提交前版本"
  description String? // 版本描述

  userId String // 创建用户
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Merkle Tree 字段
  rootTreeHash String? // 指向根目录 Tree（新版本必填）
  parentHash   String? // 父版本 ID（形成版本链，支持版本回溯）

  // 统计信息
  fileCount Int @default(0) // 版本包含的文件数量
  totalSize Int @default(0) // 版本总大小 (bytes)

  // 兼容旧版本的字段（迁移后可删除）
  snapshotKey String? // 旧的 tar.gz 路径（已废弃）
  snapshots   FileSnapshot[] // 旧的文件快照关联（已废弃）

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([rootTreeHash])
  @@index([parentHash])
}

// 文件快照（旧版本系统）- 已废弃，仅用于数据迁移
// 迁移完成后此模型将被删除
model FileSnapshot {
  id String @id @default(cuid())

  versionId String
  version   ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  filePath String // 文件路径
  content  String // 文件内容

  @@unique([versionId, filePath])
  @@index([versionId])
}

// 模板库
model Template {
  id          String  @id @default(cuid())
  name        String
  description String?

  // 分类: academic(学术论文), thesis(学位论文), cv(简历), presentation(演示文稿), book(书籍), letter(信件)
  category String

  // 标签（逗号分隔）
  tags String? // IEEE, ACM, Springer, 中文, 英文, 双栏, 单栏

  // 预览图
  thumbnailUrl String?

  // 模板来源: system(系统精选), user(用户上传)
  source String @default("system")

  // 许可证: LPPL, MIT, CC-BY, CC-BY-SA, etc.
  license    String?
  authorName String?
  authorUrl  String?

  // 模板文件存储路径（相对于 templates/ 目录）
  filesPath String
  mainFile  String @default("main.tex")

  // 模板默认编译器（用于从模板创建项目、生成预览图等）
  // "pdflatex" | "xelatex" | "lualatex" | "latex"
  defaultCompiler String @default("pdflatex")

  // 使用次数统计
  useCount Int @default(0)

  // 用户上传的模板
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 是否公开给其他用户
  isPublic Boolean @default(false)

  // 收藏关系
  favorites TemplateFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([source])
  @@index([userId])
}

// 模板收藏
model TemplateFavorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
}
